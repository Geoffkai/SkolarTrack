# Optional. Where the frontend sends its API requests.
# Leave it unset and the app uses http://localhost:3000 under `npm run dev`
# and the hosted Render API in a production build (see src/services/api.js).
#
# To override, copy this file to .env.local and uncomment the line below.
# Anything starting with VITE_ is baked into the public JavaScript bundle —
# never put a secret in a VITE_ variable.
# VITE_API_URL=http://localhost:3000
