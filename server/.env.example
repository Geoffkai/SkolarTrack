# Server
PORT=3000
NODE_ENV=development

# Database (get this from your Neon.tech dashboard)
# End it with ?sslmode=verify-full so the connection is encrypted AND the server's
# certificate is checked (sslmode=require stops checking it in the next pg major version).
DATABASE_URL=your_neon_connection_string_here

# JWT
# Generate a strong one: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters when NODE_ENV=production, or the server refuses to start.
JWT_SECRET=your_secret_key_here
JWT_EXPIRES_IN=7d

# CORS — comma-separated list of the frontend origins allowed to call this API
# (scheme + host + port, no trailing slash, no path)
CORS_ORIGINS=http://localhost:5173

# Optional — the defaults below are used when these are left out.
# Failed logins / sign-ups allowed per IP address every 15 minutes:
# AUTH_RATE_LIMIT_MAX=30
# Number of reverse proxies in front of the server (the host's load balancer):
# TRUST_PROXY=1
